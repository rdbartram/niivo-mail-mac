    "Exchange adds the original message below your text and signature when the draft is saved.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exchange fügt die ursprüngliche Nachricht beim Speichern des Entwurfs unter Ihrem Text und Ihrer Signatur ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exchange ajoute le message d'origine sous votre texte et votre signature lors de l'enregistrement du brouillon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Exchange aggiunge il messaggio originale sotto il testo e la firma quando la bozza viene salvata."
